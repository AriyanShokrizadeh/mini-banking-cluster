# Copy to /etc/mini-banking/banking.env on each banking API VM.
# Replace ALL documentation IPs/credentials. Never commit real credentials.
BANKING_APP_NAME='Mini Banking Cluster'
BANKING_INSTANCE_NAME=banking-a
BANKING_HOST=0.0.0.0
BANKING_PORT=8000
BANKING_LOG_LEVEL=INFO
BANKING_MAX_CONCURRENT_REQUESTS=50
BANKING_DATABASE_URL='postgresql+psycopg://banking_app:CHANGE_ME@/banking?host=VM1_IP:5433&host=VM2_IP:5433&host=VM3_IP:5433'
BANKING_DB_POOL_SIZE=3
BANKING_DB_MAX_OVERFLOW=2
BANKING_DB_CONNECT_TIMEOUT=3
BANKING_DB_STATEMENT_TIMEOUT_MS=10000
BANKING_DB_POOL_TIMEOUT=5
BANKING_TRANSACTION_RETRY_ATTEMPTS=3
