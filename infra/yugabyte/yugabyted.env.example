# Copy to /etc/mini-banking/yugabyted.env ON EACH DATABASE VM.
# The IP must be the private address of that VM, not loopback.
YB_NODE_IP=192.0.2.11
YB_JOIN_IP=
YB_CLOUD_LOCATION=local.lab.vm1
YB_FAULT_TOLERANCE=zone
YB_HOME=/opt/yugabyte/current
YB_BASE_DIR=/var/lib/yugabyte/cluster
# SECURITY: This lab profile is NOT authenticated/TLS protected.
# Isolate the database on a trusted, private VM network only.
